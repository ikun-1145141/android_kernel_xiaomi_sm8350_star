# Xiaomi Mi 11 Ultra (star) : temporisations du chien de garde Qualcomm.
#
# drivers/soc/qcom/Kconfig donne 11000 / 9360 ms par defaut, valeurs que
# LineageOS reprend telles quelles. Sur cet appareil la caresse du watchdog est
# retardee au-dela de 11 s pendant le demarrage : le watchdog de l'hyperviseur
# Haven mord entre 19 et 25 s, avec un reset materiel immediat et aucune trace
# logicielle (constate dans md_KDATABSS.BIN du vidage Raw_Dmp! :
# "hh-watchdog ... vWdog-expired status: 1").
#
# La ROM Xiaomi d'origine, elle, releve ces deux valeurs — releve dans
# /proc/config.gz d'un star_eea_global OS1.0.10.0.UKAEUXM en fonctionnement.
# On s'aligne dessus.
# 2026-08-11, seconde mesure : une fois la deference de pointeur nul corrigee et
# le hack `panel_dead` retire, les deces tombent a 18,3 et 19,0 s — juste sous le
# bark de 20 s — et sur des lignes sans rapport entre elles (pilote NFC d'un
# cote, initialisation WLAN de l'autre). Le noyau n'est donc pas bloque la ou il
# meurt : le reset est asynchrone, ce qui designe la morsure du chien de garde.
# On porte les temporisations a 40 / 35 s pour trancher : si les deces se
# deplacent vers 38 s, la caresse cesse d'arriver et l'on gagne vingt secondes
# de journal sur l'etat bloque. A REMETTRE a 20000 / 15000 apres la mesure.
CONFIG_QCOM_WATCHDOG_BARK_TIME=20000
CONFIG_QCOM_WATCHDOG_PET_TIME=15000

# Xiaomi utilise aussi un tampon printk plus grand (2 Mo contre 128 Ko), utile
# pour que le journal couvre tout le demarrage.
CONFIG_LOG_BUF_SHIFT=21

# 2026-08-11 : le test a 30000 / 25000 a ete annule. Les deces ne se sont pas
# deplaces d'une seconde, et le vidage Raw_Dmp! a montre la vraie cause : une
# deference de pointeur nul dans dsi_display_set_mode sur le panneau arriere.
# La morsure du chien de garde n'etait que le mecanisme de reset applique a la
# panique qui suit l'oops. On garde les valeurs Xiaomi, qui restent justes.
