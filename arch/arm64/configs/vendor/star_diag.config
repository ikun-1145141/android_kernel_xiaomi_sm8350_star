# Fragment de diagnostic pour star — TEMPORAIRE, A RETIRER APRES DIAGNOSTIC.
#
# Contexte
# --------
# Le demarrage meurt vers 17 s. La partition `minidump` (96 Mo), lue depuis le
# recovery le 2026-08-12, contient DIX enregistrements identiques ecrits par le
# firmware d'amorcage :
#
#     WDT bite: now_ticks ..., last_pat ..., from VM 3
#     Abort: Watchdog bite from PC 0x......62d8c
#     WDT: Triggering NS Watchdog Bite
#
# dont SEPT vers 24 s d'horloge hyperviseur — soit exactement les sept
# tentatives d'amorcage avant bascule en fastboot.
#
# Ce n'est PAS une morsure spontanee. Dans qcom_wdt_core.c :
#
#     static int qcom_wdt_panic_handler(...)
#     {
#         wdog_dd->in_panic = true;
#         if (WDOG_BITE_ON_PANIC ...) {
#             pr_info("Triggering early bite\n");
#             qcom_wdt_trigger_bite();
#
# Autrement dit tout panic() du noyau est CONVERTI en morsure de chien de garde,
# pour que le firmware collecte les vidages. La morsure est donc la CONSEQUENCE
# d'un panic, pas sa cause. Le motif du panic est imprime dans le tampon noyau
# juste avant.
#
# Ce que ce fragment change
# -------------------------
# La minidump ne contenait que md_TZ_DIAG.BIN et md_HYP_DIAG.BIN : aucune region
# Linux. Les options ci-dessous font enregistrer par le noyau, dans la table
# minidump, le tampon de journal et les contextes processeur, que le firmware
# recopie ensuite dans la partition au moment de la morsure. Le motif du panic
# et la pile fautive deviennent alors lisibles apres coup depuis le recovery.
#
# C'est le seul canal qui survit : pstore/ramoops est inoperant sur cet appareil
# (le chargeur Qualcomm efface la DDR — verifie par un panic sysrq volontaire non
# capture) et /data n'est pas encore utilisable a cet instant.

CONFIG_QCOM_MINIDUMP=y
CONFIG_QCOM_MINIDUMP_PANIC_DUMP=y
CONFIG_QCOM_MINIDUMP_PANIC_CPU_CONTEXT=y
CONFIG_QCOM_DYN_MINIDUMP_STACK=y
CONFIG_QCOM_MINIDUMP_FTRACE=y

# Sans ceci le firmware chiffre les regions (Kconfig : default y) et le vidage
# recupere est illisible. On veut du texte clair.
# CONFIG_QCOM_MINIDUMP_ENCRYPT is not set

# 200 entrees suffisent pour les regions par defaut, pas pour les contextes
# processeur et les piles ajoutes ci-dessus.
CONFIG_MINIDUMP_MAX_ENTRIES=512

# Un blocage doux devient une trace nominative au lieu d'un gel muet.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=20
